# HTTP port for the monitor dashboard
PORT=3000

# Path to your PaperMC server directory (used to locate logs/latest.log)
# If minecraft-monitor is a subfolder of your server, use the parent folder:
SERVER_DIR=..

# Or use an absolute path:
# SERVER_DIR=/home/you/my-paper-server

# Optional: override log file path directly
# LOG_FILE=/path/to/your/paper-server/logs/latest.log

# RCON settings (enable in server.properties: enable-rcon=true)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your-rcon-password

# Optional: protect the dashboard with a password
# DASHBOARD_PASSWORD=your-dashboard-password

# Optional: custom quick commands JSON file (copy quick-commands.example.json)
# QUICK_COMMANDS_FILE=./quick-commands.json

# How many initial log lines to send when a client connects
LOG_HISTORY_LINES=500

# MonitorBridge plugin (recommended — live TPS, structured logs)
BRIDGE_URL=http://127.0.0.1:8765
BRIDGE_API_KEY=your-bridge-api-key
